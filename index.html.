.admit-card{width:190mm;min-height:125mm;margin:10mm auto;padding:10mm;border:1.2mm solid #155eef;border-radius:4mm;background:#fff;position:relative;overflow:hidden;page-break-after:always;break-after:page}.admit-card:last-child{page-break-after:auto;break-after:auto}.admit-watermark{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;z-index:0}.admit-watermark img{width:90mm;height:90mm;object-fit:contain;opacity:.07}.admit-layer{position:relative;z-index:1}.admit-head{text-align:center;border-bottom:.4mm solid #155eef;padding-bottom:4mm;margin-bottom:5mm}.admit-head img{width:22mm;height:22mm;object-fit:contain;vertical-align:middle;margin-right:4mm}.admit-head h1{display:inline-block;vertical-align:middle;margin:0;font-size:7mm}.admit-head h2{margin:2mm 0 0;font-size:5mm;color:#155eef}.admit-info{display:grid;grid-template-columns:1fr 1fr;gap:3mm 8mm;font-size:4mm;line-height:1.6}.admit-info .full{grid-column:1/-1}.admit-photo{position:absolute;right:10mm;top:43mm;width:30mm;height:38mm;border:.5mm solid #155eef;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#f4f7fb;font-size:3mm;color:#777}.admit-photo img{width:100%;height:100%;object-fit:cover}.admit-signatures{display:flex;justify-content:space-between;margin-top:14mm;font-size:3.5mm}.admit-signatures span{border-top:.3mm solid #333;padding-top:2mm;width:42mm;text-align:center}
.id-card{
