 if(!entries.length){
  box.innerHTML='<div class="routine-empty">এই শ্রেণির কোনো রুটিন নেই। “বিষয় যোগ করুন” চাপুন।</div>';
  return;
 }
 box.innerHTML=entries.map((r,i)=>routineRowHTML(r,i)).join('');
