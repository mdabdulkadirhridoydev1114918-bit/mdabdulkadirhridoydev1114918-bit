ate,type:mode==="due"?"বকেয়া পরিশোধ":(receiptFeeItems.length?receiptFeeItems.map(x=>x.type).join(" + "):"Advance Payment"),period:mode==="due"?"—":`${period} ${year}`.trim(),items:receiptFeeItems.map(x=>({type:x.type,amount:feeMoney(x.amount)})),total:currentTotal,previousDue,payable,amount:paid,remainingDue:totalDueAfter,due:totalDueAfter,advance:advanceAmount,method,note,reference,allocations:[...oldResult.allocations,...currentResult.allocations]};db.receipts.unshift(receipt);logAudit("integrated_payment",`${receipt.receiptNo} / ${st.name} / ${paid} / ${method}`);saveDB();renderFees();renderReceipts();alert(`✅ রিসিট সংরক্ষণ হয়েছে।\nরিসিট: ${receipt.receiptNo}\nআজকের আদায়: ${bnNumber(paid)} টাকা\nঅবশিষ্ট বকেয়া: ${bnNumber(totalDueAfter)} টাকা\nAdvance: ${bnNumber(advanceAmount)} টাকা`);printReceipt(receipt);receiptFeeItems=[];document.getElementById("rcNo").value=nextReceiptNo();document.getElementById("rcAmount").value="";document.getElementById("rcNote").value="";document.getElementById("rcReference").value="";renderReceiptFeeItems();loadIntegratedPaymentInfo();}
