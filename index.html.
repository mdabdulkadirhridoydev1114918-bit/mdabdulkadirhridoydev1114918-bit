function bnDigits(v){
 return String(v).replace(/[0-9]/g,d=>"০১২৩৪৫৬৭৮৯"[d]);
}
function certYear(){ return String(db.settings.year||new Date().getFullYear()); }
function nextCertificateNo(){
 const year=certYear();
 const used=new Set((db.certificates||[]).map(c=>String(c.certNo||"").trim()));
 let n=1;
 (db.certificates||[]).forEach(c=>{const m=String(c.certNo||"").match(/(\d+)(?:\D*)$/);if(m)n=Math.max(n,Number(m[1])+1);});
 let no=bnDigits(String(n).padStart(3,"0"))+"/"+bnDigits(year);
 while(used.has(no)){n++;no=bnDigits(String(n).padStart(3,"0"))+"/"+bnDigits(year);}
 return no;
}
function findCertificate(no){
 return (db.certificates||[]).find(c=>String(c.certNo||"").trim()===String(no||"").trim());
}
function setCertificateForm(rec){
 if(!rec)return;
 const cls=document.getElementById("certClass"), stu=document.getElementById("certStudent");
 if(cls){cls.value=rec.class||""; filterStudentSelectByClass("certStudent","certClass");}
 if(stu)stu.value=rec.studentId||"";
 ["certNo","certDate","certText","certNote"].forEach(id=>{const el=document.getElementById(id); if(el)el.value=rec[id.replace("cert","").toLowerCase()]||rec[id]||"";});
 document.getElementById("certNo").value=rec.certNo||"";
 document.getElementById("certDate").value=rec.certDate||"";
 document.getElementById("certText").value=rec.text||"";
 document.getElementById("certNote").value=rec.note||"";
 generateCertificate(false);
}
function searchCertificate(){
 const no=document.getElementById("certSearchNo")?.value.trim();
 const rec=findCertificate(no);
 if(!rec){alert("এই প্রত্যয়ন পত্র নম্বরের কোনো রেকর্ড পাওয়া যায়নি।");return;}
 setCertificateForm(rec);
 alert("প্রত্যয়ন পত্রটি পাওয়া গেছে। এখন A4 প্রিন্ট / PDF চাপুন।");
}
function generateCertificate(saveRecord=true){
 if(saveRecord&&!requirePermission("certificate","add"))return;
 const sid=document.getElementById("certStudent").value;
 const st=db.students.find(s=>s.id===sid);
 if(!st){alert("শিক্ষার্থী নির্বাচন করুন");return;}
 const noEl=document.getElementById("certNo");
 let certNo=noEl?.value.trim()||"";
 if(saveRecord)certNo=nextCertificateNo();
 else if(!certNo)certNo=nextCertificateNo();
 const certDate=document.getElementById("certDate")?.value||new Date().toISOString().slice(0,10);
 const text=document.getElementById("certText")?.value.trim()||"";
 const note=document.getElementById("certNote")?.value.trim()||"";
 const formatDate=v=>{if(!v)return "";const d=new Date(v+"T00:00:00");return Number.isNaN(d.getTime())?v:d.toLocaleDateString("bn-BD",{day:"2-digit",month:"2-digit",year:"numeric"});};
 const dob=formatDate(st.dob), issueDate=formatDate(certDate);
 if(saveRecord){
  const rec={certNo,certDate,text,note,studentId:sid,class:st.class,studentName:st.name,father:st.father,mother:st.mother,roll:st.roll,studentIdValue:st.id,birthReg:st.birthReg||"",createdAt:new Date().toISOString()};
  const old=findCertificate(certNo);
  if(old && old.studentId!==sid){
    alert("এই প্রত্যয়ন নম্বরটি ইতোমধ্যে অন্য শিক্ষার্থীর জন্য ব্যবহৃত হয়েছে। নতুন নম্বর ব্যবহার করুন।");
    return;
  }
