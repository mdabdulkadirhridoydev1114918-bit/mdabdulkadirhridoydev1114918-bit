function saveExamRoutine(){
 if(!requirePermission("routine","add"))return;
 const cls=document.getElementById('routineClass')?.value;
 const box=document.getElementById('routineEditor');
 if(!cls||!box){alert('শ্রেণি নির্বাচন করুন।');return;}
 const exam=routineExamValue();
 const year=document.getElementById('routineYear')?.value.trim()||'';
 if(!exam){alert('পরীক্ষার নাম নির্বাচন/লিখুন।');return;}
 if(!year){alert('শিক্ষাবর্ষ লিখুন।');return;}
 const rows=[...box.querySelectorAll('.routine-edit-row')];
 if(!rows.length){alert('অন্তত একটি বিষয় যোগ করুন।');return;}
 const current=[]; const seen=new Set(); let invalid='';
 rows.forEach((row,idx)=>{
  const subject=row.querySelector('.routine-subject')?.value||'';
  const date=row.querySelector('.routine-date')?.value||'';
  const time=row.querySelector('.routine-time')?.value.trim()||'';
  const key=subject+'|'+date;
  if(!subject||!date||!time){invalid=`${idx+1} নম্বর লাইনে বিষয়, তারিখ ও সময় পূরণ করুন।`;return;}
  if(seen.has(key)){invalid=`${idx+1} নম্বর লাইনে একই বিষয় ও তারিখ পুনরায় দেওয়া হয়েছে।`;return;}
  seen.add(key);
  const full=row.querySelector('.routine-full')?.value||getSubjectFull(cls,subject)||'';
  current.push({class:cls,subject,date,day:dayBangla(date),time,fullMarks:Number(full)||0,room:row.querySelector('.routine-room')?.value.trim()||'',invigilator:row.querySelector('.routine-invigilator')?.value.trim()||'',exam,year});
 });
 if(invalid){alert(invalid);return;}
 db.settings.examRoutine=[...(db.settings.examRoutine||[]).filter(x=>x.class!==cls),...current];
 const meta=routineMetaStore();
 meta[cls]={year,exam,shift:document.getElementById('routineShift')?.value||'',venue:document.getElementById('routineVenue')?.value.trim()||'',instructions:document.getElementById('routineInstructions')?.value.trim()||''};
 saveDB(); logAudit('পরীক্ষার রুটিন পরিবর্তন',cls+' শ্রেণি — '+exam); renderRoutinePreview(); renderRoutineEditor(); alert('পরীক্ষার রুটিন সংরক্ষণ হয়েছে।');
}

