function nextCharacterCertificateNo(){
 const year=String(db.settings.year||new Date().getFullYear()).replace(/[^0-9]/g,"");
 const used=new Set((db.characterCertificates||[]).map(x=>String(x.certNo||"").trim()));
 let n=1;
 (db.characterCertificates||[]).forEach(x=>{const m=String(x.certNo||"").match(/(\d+)(?:\D*)$/);if(m)n=Math.max(n,Number(m[1])+1);});
 let no=`CC-${String(n).padStart(5,"0")}/${year}`;
 while(used.has(no)){n++;no=`CC-${String(n).padStart(5,"0")}/${year}`;}
 return no;
}
