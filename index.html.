async function login(){
 ensureDB();
 const username=document.getElementById("loginUser").value.trim();
 const password=document.getElementById("loginPass").value;
 const errorBox=document.getElementById("loginError");
 if(errorBox)errorBox.textContent="";
 if(!username||!password){
  if(errorBox)errorBox.textContent="❌ ইউজারনেম / Student ID এবং পাসওয়ার্ড দিন";
  return;
 }

 try{
  const result=await supabaseLogin(username,password);
  const p=result.profile;
  const user={
   username:p.username,
   password:"",
   role:normalizeRole(p.role),
   name:p.display_name||p.username,
   person_id:p.person_id||"",
   permissions:normalizeSecurityPermissions({role:p.role})
  };
  if(p.role==="student"){
   user.studentId=result.student?.id||"";
   user.studentNo=result.student?.student_no||"";
   user.studentData=result.student;
   applyStudentScope(result.student);
  }else{
   currentUser=user;
   await loadSchoolDataFromSupabase();
  }
  showLoggedInUser(user);
 }catch(e){
  console.error(e);
  if(errorBox)errorBox.textContent="❌ লগইন ব্যর্থ: "+(e?.message||"ইউজারনেম/পাসওয়ার্ড সঠিক নয়");
 }
}

