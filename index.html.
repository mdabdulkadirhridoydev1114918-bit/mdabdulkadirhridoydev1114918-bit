   <td>${r?bnNumber(r.total):'ফলাফল নেই'}</td>
   <td>${r?esc(r.percentage)+'%':'—'}</td>
   <td class="new-promo-roll">—</td>
   <td><select class="promotion-status" data-student-id="${esc(st.id)}" onchange="updatePromotionRow(this)">
    <option value="pending">⏳ অমীমাংসিত</option>
    <option value="promoted">✅ উত্তীর্ণ</option>
    <option value="repeat">❌ ফেল / পুনরায়</option>
    <option value="conditional">⚠️ শর্তসাপেক্ষ</option>
   </select></td>
  </tr>`;
 }).join("")}</tbody></table>
 <small>* নতুন রোল শুধু "উত্তীর্ণ" শিক্ষার্থীদের জন্য মেধাক্রম অনুযায়ী তৈরি হবে। ফলাফল না থাকলে শিক্ষার্থীকে উত্তীর্ণ করা যাবে না।</small>`;
 updatePromotionNewRollPreview();
}

