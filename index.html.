function bnNumber(v){
 return String(v??"").replace(/[0-9]/g,d=>"০১২৩৪৫৬৭৮৯"[d]);
}

function allAcademicYears(){
 const years=new Set([String(db.settings.year||"")]);
 db.students.forEach(s=>(s.academicHistory||[]).forEach(h=>years.add(String(h.academicYear||""))));
 (db.promotionHistory||[]).forEach(p=>{
  if(p.fromYear)years.add(String(p.fromYear));
  if(p.toYear)years.add(String(p.toYear));
 });
 return [...years].filter(Boolean).sort((a,b)=>String(a).localeCompare(String(b),undefined,{numeric:true}));
}

