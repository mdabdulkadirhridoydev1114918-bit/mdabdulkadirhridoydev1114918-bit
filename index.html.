function admitQRHTML(st){
 const name=String(st?.name||'').trim();
 const roll=String(st?.roll||'').trim();
 const id=String(st?.id||'').trim();
 const cls=String(st?.class||st?.className||'').trim();
 // QR payload: সরাসরি UTF-8 বাংলা/ইংরেজি তথ্য রাখা হচ্ছে।
 // encodeURIComponent ব্যবহার করা হচ্ছে না, তাই স্ক্যান করলে %E0... ধরনের লেখা আসবে না।
 const payload=[
  'শিক্ষার্থীর নাম: '+name,
  'রোল: '+roll,
  'Student ID: '+id,
  'শ্রেণি: '+cls
 ].join('\n');
 try{
  if(typeof QRCode!=="function") throw new Error("Offline QR engine unavailable");
  const qr=new QRCode(0,QRErrorCorrectLevel.L);
  qr.addData(payload);
  qr.make();
  const n=qr.getModuleCount(), scale=3, margin=4, size=(n+margin*2)*scale;
  let path='';
  for(let r=0;r<n;r++){
   for(let c=0;c<n;c++){
    if(qr.isDark(r,c)) path+=`M${(c+margin)*scale},${(r+margin)*scale}h${scale}v${scale}h-${scale}z`;
   }
  }
  return `<div class="admit-qr" title="Offline QR Code"><svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 ${size} ${size}" shape-rendering="crispEdges"><rect width="100%" height="100%" fill="#fff"/><path d="${path}" fill="#000"/></svg></div>`;
 }catch(e){
  console.error("Admit QR error:",e);
  return `<div class="admit-qr admit-qr-error">QR তৈরি হয়নি</div>`;
 }
}
