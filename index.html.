const promotionOrder=["১ম","২য়","৩য়","৪র্থ","৫ম","৬ষ্ঠ","৭ম","৮ম","৯ম","১০ম"];

function promotionNextClass(cls){
 const i=promotionOrder.indexOf(String(cls||""));
 return i>=0 && i<promotionOrder.length-1 ? promotionOrder[i+1] : "";
}

function getPromotionYear(){
 return String(db.settings.year||new Date().getFullYear());
}

function promotionStatusLabel(v){
 return ({promoted:"উত্তীর্ণ",repeat:"ফেল / পুনরায়",conditional:"শর্তসাপেক্ষ",pending:"অমীমাংসিত"})[v]||"অমীমাংসিত";
}

function promotionStatusClass(v){
 return ({promoted:"promo-promoted",repeat:"promo-repeat",conditional:"promo-conditional",pending:"promo-pending"})[v]||"promo-pending";
}

function getPromotionExamList(){
 const exams=[...new Set((db.marks||[]).map(m=>String(m.exam||"").trim()).filter(Boolean))];
 return exams.sort((a,b)=>a.localeCompare(b,"bn"));
}

function getPromotionResult(st,exam){
 if(!exam)return null;
 const r=calculateResult(st.id,exam);
 if(!r || !r.rows || !r.rows.length)return null;
 return r;
}

function promotionRollNumber(v){
 const n=String(v??"").replace(/[^0-9]/g,"");
 const x=parseInt(n,10);
 return Number.isFinite(x)?x:999999;
}

function setPromotionDefaults(){
 const from=document.getElementById("promotionFromYear");
 const to=document.getElementById("promotionToYear");
 const cls=document.getElementById("promotionClass");
 const exam=document.getElementById("promotionExam");
 if(!from||!to||!cls||!exam)return;
 from.value=getPromotionYear();
 if(!to.value){
  const n=parseInt(getPromotionYear().replace(/[^0-9]/g,""),10);
  to.value=Number.isFinite(n)?String(n+1):"";
 }
 const oldClass=cls.value;
 cls.innerHTML='<option value="">সকল শ্রেণি</option>'+promotionOrder.map(c=>`<option value="${esc(c)}">${esc(c)}</option>`).join("");
 if(promotionOrder.includes(oldClass))cls.value=oldClass;
 const oldExam=exam.value;
 const exams=getPromotionExamList();
 exam.innerHTML='<option value="">পরীক্ষা নির্বাচন করুন</option>'+exams.map(x=>`<option value="${esc(x)}">${esc(x)}</option>`).join("");
 if(exams.includes(oldExam))exam.value=oldExam;
 else if(exams.length===1)exam.value=exams[0];
 renderPromotionStudents();
}

function promotionStudentNeedsDecision(st,fromYear){
 if(st.promotionYear===fromYear && st.promotionDecision)return false;
 if(st.status==="graduated")return false;
 return promotionOrder.includes(String(st.class||""));
}

function renderPromotionStudents(){
