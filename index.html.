function routineRowHTML(r,i){
 const subjects=routineSubjects(r.class||document.getElementById('routineClass')?.value||'');
 const opts=(subjects.length?'<option value="">বিষয় নির্বাচন করুন</option>':'<option value="">এই শ্রেণির কোনো বিষয় নেই</option>')+subjects.map(x=>`<option value="${esc(x.name)}" ${x.name===r.subject?'selected':''}>${esc(x.name)}${x.full?' — '+esc(x.full)+' নম্বর':''}</option>`).join('');
 return `<div class="routine-edit-row" data-routine-index="${i}">
 <div><label>বিষয়</label><select class="routine-subject" onchange="syncRoutineFullMark(this)">${opts}</select></div>
 <div><label>তারিখ</label><input type="date" class="routine-date" value="${esc(r.date||'')}" onchange="updateRoutineDay(this)"></div>
 <div><label>বার</label><input type="text" class="routine-day" value="${esc(r.day||dayBangla(r.date)||'')}" readonly></div>
 <div><label>সময়</label><input type="text" class="routine-time" placeholder="১০:০০–১:০০" value="${esc(r.time||'')}"></div>
 <div><label>পূর্ণমান</label><input type="number" class="routine-full" min="0" value="${esc(r.fullMarks??getSubjectFull(r.class,r.subject))}" placeholder="100"></div>
 <div><label>কক্ষ</label><input type="text" class="routine-room" placeholder="১০১" value="${esc(r.room||'')}"></div>
 <div><label>পরিদর্শক/শিক্ষক</label><input type="text" class="routine-invigilator" placeholder="শিক্ষকের নাম" value="${esc(r.invigilator||'')}"></div>
 <div class="routine-actions"><button class="danger" type="button" onclick="removeRoutineRow(this)">🗑️ বাদ</button></div>
 </div>`;
}

function getSubjectFull(cls,subject){
 const found=routineSubjects(cls).find(x=>x.name===subject);
 return found?.full||'';
}

function syncRoutineFullMark(select){
 const row=select?.closest('.routine-edit-row');
 const cls=document.getElementById('routineClass')?.value||'';
 if(!row)return;
