function supabaseLoginEmailFallback(username){
 const u=String(username||"").trim().toLowerCase();
 if(!u)return "";
 /* New accounts may use these internal aliases. Existing accounts are resolved
    securely through the SQL RPC included with this version. */
 if(/^stu[0-9_-]+$/.test(u)) return `${u}@student.local`;
 return `${u}@school.local`;
}

async function supabaseResolveLoginEmail(username){
 const u=String(username||"").trim();
 try{
  const {data,error}=await supabaseClient.rpc("get_login_email",{p_username:u});
  if(!error && data) return String(data);
  const {data:studentEmail, error:studentError}=await supabaseClient.rpc("get_student_login_email",{p_student_id:u});
  if(!studentError && studentEmail) return String(studentEmail);
 }catch(e){}
 return supabaseLoginEmailFallback(u);
}

async function loadSchoolDataFromSupabase(){
 if(!currentUser || normalizeRole(currentUser.role)==="student")return false;
 try{
  const {data,error}=await supabaseClient.from("school_app_data")
   .select("data").eq("id","main").maybeSingle();
  if(error)throw error;
  if(data?.data && typeof data.data==="object"){
   db=data.data;
   ensureDB();
   localStorage.setItem(KEY,JSON.stringify(db));
   return true;
  }
 }catch(e){console.warn("Online school data load failed",e)}
 return false;
}

async function syncSchoolDataToSupabase(){
 if(!currentUser || normalizeRole(currentUser.role)==="student")return;
 try{
  const {data:{session}}=await supabaseClient.auth.getSession();
  if(!session?.user)return;
  const {error}=await supabaseClient.from("school_app_data").upsert({
   id:"main",
   data:db,
   updated_by:session.user.id,
   updated_at:new Date().toISOString()
  },{onConflict:"id"});
  if(error)throw error;
 }catch(e){console.warn("Online school data save failed",e)}
}

async function supabaseLogin(username,password){
 const email=await supabaseResolveLoginEmail(username);
 if(!email)throw new Error("ইউজারনেম দিন");
 const {data,error}=await supabaseClient.auth.signInWithPassword({email,password});
 if(error)throw error;
 if(!data?.user)throw new Error("Supabase লগইন ব্যর্থ হয়েছে");

 let {data:profile,error:profileError}=await supabaseClient
   .from("user_profiles")
   .select("id,username,role,display_name,person_id,active")
   .eq("id",data.user.id)
   .maybeSingle();
 if(profileError)throw profileError;

 let student=null;
 if(!profile){
  const {data:sa,error:saError}=await supabaseClient
   .from("student_accounts")
   .select("id,student_id,username,display_name,active")
   .eq("id",data.user.id).maybeSingle();
  if(saError)throw saError;
  if(sa)profile={id:sa.id,username:sa.username,role:"student",display_name:sa.display_name,person_id:sa.student_id,active:sa.active};
 }
 if(!profile || profile.active===false)throw new Error("এই ব্যবহারকারীর অ্যাকাউন্ট সক্রিয় নয়");
 if(String(profile.role).toLowerCase()==="student"){
  const {data:st,error:stError}=await supabaseClient
   .from("students")
   .select("*")
   .eq("user_id",data.user.id)
   .maybeSingle();
  if(stError)throw stError;
  if(!st)throw new Error("এই Student ID-এর তথ্য পাওয়া যায়নি");
  student=st;
 }

 return {user:data.user,profile,student};
}

function applyStudentScope(student){
 if(!student)return;
 const sid=student.id;
 const studentNo=student.student_no||student.studentNo||"";
 const same=(x)=>String(x?.studentId||x?.student_id||x?.studentNo||x?.student_no||"")===String(sid)||
                  String(x?.studentId||x?.student_id||x?.studentNo||x?.student_no||"")===String(studentNo);
 db.students=[{
  id:student.id,
  user_id:student.user_id,
  studentNo:student.student_no,
  student_no:student.student_no,
  name:student.name,
  nameEn:student.name_en,
  class:student.class,
  roll:student.roll,
  father:student.father,
  mother:student.mother,
  dob:student.dob,
  birthReg:student.birth_reg,
  mobile:student.mobile,
  blood:student.blood,
  fatherNid:student.father_nid,
  fatherDob:student.father_dob,
  motherNid:student.mother_nid,
  motherDob:student.mother_dob,
  photo:student.photo,
  status:student.status
 }];
 ["marks","attendance","fees","certificates","awards","disciplineRecords","tcRecords","examAttendance","characterCertificates"].forEach(k=>{
  if(Array.isArray(db[k])) db[k]=db[k].filter(same);
 });
}

