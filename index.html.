 const docHtml=`<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>প্রিন্ট</title>
<style>${printCss}</style>
<style>${extraCss}</style>


</head>
<body>${html}
<script>
/* Print is controlled by the parent iframe handler below.
   Do not call window.print() here, otherwise the same document can print twice. */
<\/script>
</body>
</html>`;

 doc.open();
 doc.write(docHtml);
 doc.close();

 /* iframe print support */
 setTimeout(()=>{
   try{
     const idoc=frame.contentDocument || frame.contentWindow.document;
     const imgs=Array.from(idoc.images||[]);
     const printNow=()=>setTimeout(()=>{
       try{
         frame.contentWindow.focus();
         frame.contentWindow.print();
       }catch(e){
         /* Fallback: popup only if iframe printing is blocked */
         const w=window.open("","_blank");
         if(w){
           w.document.open();
           w.document.write(docHtml.replace('</body>','<script>window.addEventListener("load",()=>setTimeout(()=>window.print(),300),{once:true});<\/script></body>'));
           w.document.close();
         }else{
           alert("প্রিন্ট চালু করা যাচ্ছে না। ব্রাউজারের Print/Share মেনু থেকে প্রিন্ট নির্বাচন করুন।");
         }
       }
     },180);

     if(!imgs.length){printNow();return;}
     let left=imgs.length, fired=false;
     const done=()=>{
       left--;
       if(left<=0 && !fired){fired=true;printNow();}
     };
     imgs.forEach(img=>{
       if(img.complete) done();
       else{
         img.addEventListener("load",done,{once:true});
         img.addEventListener("error",done,{once:true});
       }
     });
     setTimeout(()=>{if(!fired){fired=true;printNow();}},2500);
   }catch(e){
     try{frame.contentWindow.print();}catch(_){}
   }
 },100);

 frame.contentWindow.addEventListener("afterprint",()=>{
   setTimeout(()=>frame.remove(),800);
 });
}
