const SECURITY_PERMISSION_MODULES={
 dashboard:"ড্যাশবোর্ড", students:"শিক্ষার্থী", promotion:"শ্রেণি উন্নীতকরণ", marks:"নম্বর এন্ট্রি", report:"রিপোর্ট কার্ড", marksheet:"মার্কশিট", admitcard:"এডমিট কার্ড", routine:"পরীক্ষার রুটিন", attendance:"উপস্থিতি", teachers:"শিক্ষক/কর্মচারী", idcard:"আইডি কার্ড", certificate:"প্রত্যয়ন/সনদ", awards:"পুরস্কার/সনদ রেকর্ড", discipline:"শৃঙ্খলা রেকর্ড", tc:"TC", fees:"ফি ও বেতন", subjects:"বিষয়", settings:"প্রতিষ্ঠানের সেটিংস", password:"পাসওয়ার্ড", backup:"Backup/Restore", adminReports:"প্রশাসনিক রিপোর্ট", security:"নিরাপত্তা ও ইউজার", characterCertificate:"চারিত্রিক সনদ", examAttendance:"পরীক্ষার উপস্থিতি", notices:"নোটিশ", calendar:"ক্যালেন্ডার", receipt:"মানি রিসিট"
};

const ROLE_PAGES={
 admin:Object.keys(SECURITY_PERMISSION_MODULES),
 headmaster:Object.keys(SECURITY_PERMISSION_MODULES),
 teacher:["dashboard","students","marks","report","marksheet","admitcard","routine","attendance","idcard","awards","discipline","characterCertificate","examAttendance","password"],
 office:["dashboard","students","report","idcard","certificate","awards","discipline","tc","fees","receipt","notices","calendar","password"],
 student:["dashboard","students","report","marksheet","admitcard","routine","attendance","notices","calendar","password"]
};

function normalizeRole(role){
 const r=String(role||"teacher").toLowerCase();
 return ROLE_LABELS[r]?r:"teacher";
}

function defaultSecurityPermissions(role){
 const pages=new Set(ROLE_PAGES[normalizeRole(role)]||ROLE_PAGES.teacher);
 const out={};
 Object.keys(SECURITY_PERMISSION_MODULES).forEach(m=>{
  const view=pages.has(m);
  out[m]={view,add:view,edit:view,delete:view};
 });
 if(normalizeRole(role)==="teacher"){
  ["students","marks","attendance","awards","discipline"].forEach(m=>{if(out[m])out[m].delete=false;});
 }
 if(normalizeRole(role)==="office"){
  ["students","certificate","awards","discipline","tc","fees"].forEach(m=>{if(out[m])out[m].edit=true;});
 }
 return out;
}

function normalizeSecurityPermissions(user){
 const role=normalizeRole(user?.role);
 const base=defaultSecurityPermissions(role);
 const src=user?.permissions||{};
 Object.keys(SECURITY_PERMISSION_MODULES).forEach(m=>{
  if(src[m]){
   ["view","add","edit","delete"].forEach(a=>{if(typeof src[m][a]==="boolean")base[m][a]=src[m][a];});
  }
  if(base[m].add||base[m].edit||base[m].delete)base[m].view=true;
 });
 return base;
}

function isAdmin(){
 return !!currentUser && normalizeRole(currentUser.role)==="admin";
}

function currentPermissions(){
 if(!currentUser)return {};
 if(isAdmin())return Object.fromEntries(Object.keys(SECURITY_PERMISSION_MODULES).map(m=>[m,{view:true,add:true,edit:true,delete:true}]));
 return normalizeSecurityPermissions(currentUser);
}

function canPermission(module,action="view"){
 if(!currentUser)return false;
 if(isAdmin())return true;
 return !!currentPermissions()?.[module]?.[action];
}

function requirePermission(module,action="view"){
 if(canPermission(module,action))return true;
 const label=SECURITY_PERMISSION_MODULES[module]||module;
 const a={view:"দেখার",add:"নতুন তথ্য যোগ/এন্ট্রি করার",edit:"পরিবর্তন করার",delete:"মুছে ফেলার"}[action]||"এই কাজের";
 alert(`🔒 আপনার এই মডিউলে ${a} অনুমতি নেই।\n\nমডিউল: ${label}`);
 return false;
}

function canAccessPage(id){
 return canPermission(id,"view");
}

function buildSecurityPermissionEditor(permissions){
 const p=permissions||defaultSecurityPermissions(document.getElementById("secNewRole")?.value||"teacher");
 const actions=[["view","দেখুন"],["add","এন্ট্রি"],["edit","পরিবর্তন"],["delete","মুছুন"]];
 const box=document.getElementById("securityPermissionEditor");
 if(!box)return;
 box.innerHTML=Object.entries(SECURITY_PERMISSION_MODULES).map(([m,label])=>`<div class="permission-row" data-module="${m}"><div class="perm-title">${label}</div>${actions.map(([a,t])=>`<label><input type="checkbox" data-perm-action="${a}" ${p[m]?.[a]?'checked':''}>${t}</label>`).join("")}</div>`).join("");
}

function readSecurityPermissionEditor(){
 const out={};
 document.querySelectorAll("#securityPermissionEditor .permission-row").forEach(row=>{
  const m=row.dataset.module; out[m]={};
  row.querySelectorAll("input[data-perm-action]").forEach(i=>out[m][i.dataset.permAction]=i.checked);
 });
 return out;
}

function setAllSecurityPermissions(value){
 document.querySelectorAll("#securityPermissionEditor input[data-perm-action]").forEach(i=>i.checked=!!value);
}

function applyRoleSecurityPermissions(){
 buildSecurityPermissionEditor(defaultSecurityPermissions(document.getElementById("secNewRole")?.value||"teacher"));
}

function applyAccessControl(){
