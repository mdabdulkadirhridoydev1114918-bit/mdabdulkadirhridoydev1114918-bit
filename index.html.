function clearNoticeForm(){
 ["noticeTitle","noticeBody","noticeEditId"].forEach(id=>{const e=document.getElementById(id);if(e)e.value="";});
 const d=document.getElementById("noticeDate");if(d)d.value=new Date().toISOString().slice(0,10);
 const c=document.getElementById("noticeCategory");if(c)c.value="সাধারণ"; const a=document.getElementById("noticeAudience");if(a)a.value="সকল";
 const im=document.getElementById("noticeImportant");if(im)im.checked=false; const af=document.getElementById("noticeAttachment");if(af)af.value=""; const ai=document.getElementById("noticeAttachmentInfo");if(ai)ai.textContent="";
 const b=document.querySelector('#notices button[onclick="saveNotice()"]');if(b)b.textContent="💾 নোটিশ সংরক্ষণ";
}
function saveNotice(){
 if(!requirePermission("notices","add"))return;
 if(!requirePermission("dashboard","add"))return;
 ensureDB();
 const title=(document.getElementById("noticeTitle")?.value||"").trim();
 const body=(document.getElementById("noticeBody")?.value||"").trim();
 if(!title||!body){alert("নোটিশের শিরোনাম ও বিস্তারিত লিখুন।");return;}

 const editId=document.getElementById("noticeEditId")?.value||"";
 const date=document.getElementById("noticeDate")?.value||new Date().toISOString().slice(0,10);
 const category=document.getElementById("noticeCategory")?.value||"সাধারণ";
 const audience=document.getElementById("noticeAudience")?.value||"সকল";
 const important=!!document.getElementById("noticeImportant")?.checked;
 const file=document.getElementById("noticeAttachment")?.files?.[0];

 if(file && file.size>2*1024*1024){
   alert("সংযুক্ত PDF/ইমেজ সর্বোচ্চ 2 MB হতে হবে।");
   return;
 }

 const oldNotice=editId?(db.notices||[]).find(x=>x.id===editId):null;

 const finish=(attachment)=>{
   if(editId){
     const n=(db.notices||[]).find(x=>x.id===editId);
     if(!n)return;
     Object.assign(n,{
       title,body,date,category,audience,important,
       updatedAt:new Date().toISOString()
     });
     if(attachment)n.attachment=attachment;
     else if(file===undefined && oldNotice?.attachment)n.attachment=oldNotice.attachment;
     logAudit("notice_update",title);
   }else{
     const n={
       id:"NOTICE-"+Date.now()+"-"+Math.random().toString(36).slice(2,7),
       title,body,date,category,audience,important,
       createdAt:new Date().toISOString(),
       createdBy:currentUser?.username||"admin"
     };
     if(attachment)n.attachment=attachment;
     db.notices.unshift(n);
     logAudit("notice_create",title);
   }
   try{
     saveDB();
   }catch(e){
     alert("⚠️ নোটিশ সংরক্ষণ করা যায়নি। LocalStorage-এর জায়গা কম থাকতে পারে।");
     console.error(e);
     return;
   }
   clearNoticeForm();
   renderNotices();
   renderDashboardLatestNotice();
   alert("✅ নোটিশ সংরক্ষণ হয়েছে।");
 };

 if(file){
   const reader=new FileReader();
   reader.onload=()=>finish({
     name:file.name,
     type:file.type||"application/octet-stream",
     size:file.size,
     data:reader.result
   });
   reader.onerror=()=>alert("⚠️ সংযুক্ত ফাইল পড়া যায়নি।");
   reader.readAsDataURL(file);
 }else{
   finish(oldNotice?.attachment||null);
 }
}

function editNotice(id){
 if(!requirePermission("notices","edit"))return;const n=(db.notices||[]).find(x=>x.id===id);if(!n)return;document.getElementById("noticeTitle").value=n.title||"";document.getElementById("noticeBody").value=n.body||"";document.getElementById("noticeDate").value=n.date||"";document.getElementById("noticeCategory").value=n.category||"সাধারণ";document.getElementById("noticeAudience").value=n.audience||"সকল";document.getElementById("noticeImportant").checked=!!n.important;document.getElementById("noticeEditId").value=id;const b=document.querySelector('#notices button[onclick="saveNotice()"]');if(b)b.textContent="💾 পরিবর্তন সংরক্ষণ";document.getElementById("noticeTitle").focus();}
function deleteNotice(id){
 if(!requirePermission("notices","delete"))return;const n=(db.notices||[]).find(x=>x.id===id);if(!n)return;if(!confirm("এই নোটিশটি মুছে ফেলতে চান?"))return;db.notices=db.notices.filter(x=>x.id!==id);logAudit("notice_delete",n.title||id);saveDB();renderNotices();}
function noticeFiltered(){const q=(document.getElementById("noticeSearch")?.value||"").trim().toLowerCase(),c=document.getElementById("noticeFilterCategory")?.value||"";return (db.notices||[]).filter(n=>(!c||n.category===c)&&(!q||[n.title,n.body,n.category,n.audience].some(v=>String(v||"").toLowerCase().includes(q)))).sort((a,b)=>(b.important-a.important)||String(b.date||"").localeCompare(String(a.date||"")));}
function renderNotices(){
 ensureDB();
 const box=document.getElementById("noticeList");
 if(!box)return;
 const arr=noticeFiltered();
 if(!arr.length){
   box.innerHTML='<div class="routine-empty">📭 কোনো নোটিশ পাওয়া যায়নি।</div>';
   return;
 }
 box.innerHTML=arr.map(n=>{
   const att=n.attachment;
   const isImg=att && String(att.type||"").startsWith("image/");
   const attachmentHtml=att
     ? `<div style="margin-top:10px;padding:9px;border:1px dashed #b9c5d6;border-radius:8px;background:#f8fafc">
          ${isImg && att.data?`<img src="${att.data}" alt="সংযুক্ত ছবি" style="max-width:180px;max-height:120px;display:block;border-radius:6px;margin-bottom:7px;object-fit:contain">`:""}
          📎 <a href="${att.data}" target="_blank" download="${esc(att.name||"attachment")}">${esc(att.name||"সংযুক্ত ফাইল")}</a>
          <span style="font-size:11px;color:#777"> (${((Number(att.size)||0)/1024/1024).toFixed(2)} MB)</span>
        </div>` : "";
   return `<div style="border:1px solid #dbe3ee;border-radius:12px;padding:14px;margin-bottom:10px;background:${n.important?'#fff9e8':'#fff'};border-left:5px solid ${n.important?'#f59e0b':'#155eef'}">
     <div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start;flex-wrap:wrap">
       <div><b style="font-size:17px">${n.important?'⭐ ':''}${esc(n.title)}</b>
       <div style="color:#687687;font-size:12px;margin-top:4px">📅 ${esc(n.date||'')} | ${esc(n.category||'সাধারণ')} | ${esc(n.audience||'সকল')}</div></div>
       <div><button onclick="printNoticeById('${n.id}')">🖨️ প্রিন্ট</button><button onclick="editNotice('${n.id}')">✏️ Edit</button><button class="danger" onclick="deleteNotice('${n.id}')">🗑️ মুছুন</button></div>
     </div>
     <div style="margin-top:10px;line-height:1.8;white-space:pre-wrap">${esc(n.body)}</div>
     ${attachmentHtml}
   </div>`;
 }).join('');
}

function printNoticeById(id){
 ensureDB();
 const n=(db.notices||[]).find(x=>String(x.id)===String(id));
 if(!n){alert("নোটিশ পাওয়া যায়নি।");return;}
 const w=window.open("","_blank");
