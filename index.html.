}

function nextStudentNo(){
 const year=String(db.settings.year||new Date().getFullYear()).replace(/[^0-9]/g,"");
 const nums=db.students.map(s=>{
  const m=String(s.studentNo||"").match(/(\d{4})$/);
  return m?Number(m[1]):0;
 }).filter(Number.isFinite);
 return "STU-"+year+"-"+String((nums.length?Math.max(...nums):0)+1).padStart(4,"0");
}

function normalizeAcademicHistory(){
