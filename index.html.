/* ===== CERTIFICATE - A4 OFFICIAL DESIGN ===== */
.certificate-preview{
  background:#eef3f8;border:1px solid #d6dee8;border-radius:14px;
  padding:14px;overflow:auto
}
.certificate-page{
  width:210mm;height:297mm;min-width:210mm;min-height:297mm;
  max-width:210mm;max-height:297mm;margin:0 auto;padding:14mm;
  background:#fff;position:relative;overflow:hidden;
  border:1.2mm solid #173b63;box-sizing:border-box;
  box-shadow:0 3px 14px #0001;
}
.certificate-page:before{
  content:"";position:absolute;inset:4mm;border:.35mm solid #9aaabd;
  pointer-events:none;z-index:0;
}
.certificate-page:after{
  content:"";position:absolute;left:0;right:0;top:0;height:7mm;
  background:#173b63;z-index:0;
}
.certificate-watermark{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  pointer-events:none;z-index:0;overflow:hidden
}
.certificate-watermark img{
  width:105mm;height:105mm;object-fit:contain;opacity:.045
}
.certificate-layer{position:relative;z-index:1;margin:7mm 6mm 0}
.certificate-header{
  text-align:center;border-bottom:.45mm solid #173b63;
  padding-bottom:5mm;margin-bottom:9mm
