async function restoreSupabaseSession(){
 try{
  const {data}=await supabaseClient.auth.getSession();
  const session=data?.session;
  if(!session?.user)return false;
  let {data:p,error}=await supabaseClient.from("user_profiles")
   .select("id,username,role,display_name,person_id,active")
   .eq("id",session.user.id).maybeSingle();
  if(error)return false;
  if(!p){
   const {data:sa}=await supabaseClient.from("student_accounts")
    .select("id,student_id,username,display_name,active")
    .eq("id",session.user.id).maybeSingle();
   if(sa)p={id:sa.id,username:sa.username,role:"student",display_name:sa.display_name,person_id:sa.student_id,active:sa.active};
  }
  if(!p||p.active===false)return false;
  const user={username:p.username,password:"",role:normalizeRole(p.role),name:p.display_name||p.username,person_id:p.person_id||"",permissions:normalizeSecurityPermissions({role:p.role})};
  if(p.role==="student"){
   const {data:st}=await supabaseClient.from("students").select("*").eq("user_id",session.user.id).maybeSingle();
   if(st){user.studentId=st.id;user.studentNo=st.student_no;user.studentData=st;applyStudentScope(st);}
  }else{
   currentUser=user;
   await loadSchoolDataFromSupabase();
  }
  showLoggedInUser(user);
  return true;
 }catch(e){console.warn("Supabase session restore failed",e);return false;}
}

