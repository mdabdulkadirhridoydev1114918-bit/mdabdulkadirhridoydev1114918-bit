/* =====================================================
GRADE
===================================================== */

function grade(score,full){

 const percent=(Number(score)/Number(full))*100;

 if(percent>=80)return {grade:"A+",point:5};
 if(percent>=70)return {grade:"A",point:4};
 if(percent>=60)return {grade:"A-",point:3.5};
 if(percent>=50)return {grade:"B",point:3};
 if(percent>=40)return {grade:"C",point:2};
 if(percent>=33)return {grade:"D",point:1};

 return {grade:"F",point:0};
}

function calculateResult(studentId,exam){

 const st=db.students.find(s=>s.id===studentId);

 if(!st)return null;

 const subjects=getSubjects(st.class);

 let total=0;
 let fullTotal=0;
 let pointTotal=0;
 let count=0;
 let fail=false;

 const rows=[];

 subjects.forEach(sub=>{

  const mark=db.marks.find(m=>
   m.studentId===studentId &&
   m.exam===exam &&
   m.subject===sub.name
  );

  if(!mark)return;

  const g=grade(mark.score,mark.full||sub.full);

  total+=Number(mark.score);
  fullTotal+=Number(mark.full||sub.full);
  pointTotal+=g.point;
  count++;

  if(g.grade==="F")fail=true;

  rows.push({
   subject:sub.name,
   full:mark.full||sub.full,
   score:mark.score,
   grade:g.grade,
   point:g.point
  });

 });

 return {
  rows,
  total,
  fullTotal,
  percentage:fullTotal?
  ((total/fullTotal)*100).toFixed(2):"0.00",
  gpa:count?(pointTotal/count).toFixed(2):"0.00",
  result:fail?"অকৃতকার্য":"উত্তীর্ণ"
 };
}

