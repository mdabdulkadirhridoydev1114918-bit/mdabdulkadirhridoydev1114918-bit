 const school=esc(db.settings?.name||"স্কুল");
 const address=esc(db.settings?.address||"");
 const phone=esc(db.settings?.phone||"");
 const attachment=n.attachment;
 const isImg=attachment&&String(attachment.type||"").startsWith("image/");
