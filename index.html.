  margin:0;font-size:7mm;font-weight:800;color:#173b63
}
.certificate-header .address{
  margin-top:2mm;font-size:3.4mm;color:#5d6875
}
.certificate-title{
  display:inline-block;margin-top:5mm;padding:2.5mm 12mm;
  border:.55mm solid #173b63;border-radius:2mm;
  color:#173b63;font-size:6mm;font-weight:800;letter-spacing:.5mm;
  background:#f8fafc
