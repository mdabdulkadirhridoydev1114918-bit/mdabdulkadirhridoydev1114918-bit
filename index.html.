function applyPromotionDecisions(){
 const fromYear=getPromotionYear();
 const toYear=document.getElementById("promotionToYear")?.value.trim();
 const exam=document.getElementById("promotionExam")?.value||"";
 if(!toYear){alert("নতুন শিক্ষাবর্ষ লিখুন।");return;}
 if(String(fromYear)===String(toYear)){alert("নতুন শিক্ষাবর্ষ বর্তমান শিক্ষাবর্ষের চেয়ে আলাদা দিন।");return;}
 if(!exam){alert("মেধাক্রম নির্ধারণের জন্য পরীক্ষাটি নির্বাচন করুন।");return;}

 const decisions=[...document.querySelectorAll("#promotionStudentTable .promotion-status")]
  .map(el=>({id:el.dataset.studentId,status:el.value}))
  .filter(x=>x.status!=="pending");
 if(!decisions.length){alert("কমপক্ষে একজন শিক্ষার্থীর ফলাফল নির্বাচন করুন।");return;}

 const promoted=decisions.filter(x=>x.status==="promoted").length;
 const repeat=decisions.filter(x=>x.status==="repeat").length;
 const conditional=decisions.filter(x=>x.status==="conditional").length;

 const promotedStudents=decisions.map(d=>({d,st:db.students.find(s=>s.id===d.id)}))
  .filter(x=>x.st && x.d.status==='promoted')
  .map(x=>({...x,result:getPromotionResult(x.st,exam)}));
 const missing=promotedStudents.filter(x=>!x.result || !x.result.rows.length);
 if(missing.length){
  alert('যাদের ফলাফল নেই তাদের উত্তীর্ণ করা যাবে না।\n\nফলাফল না থাকা শিক্ষার্থী: '+missing.map(x=>x.st.name).join(', '));
  return;
 }
 promotedStudents.sort((a,b)=>{
  const totalDiff=Number(b.result.total)-Number(a.result.total);
  if(totalDiff!==0)return totalDiff;
  const pctDiff=Number(b.result.percentage)-Number(a.result.percentage);
  if(pctDiff!==0)return pctDiff;
  return promotionRollNumber(a.st.roll)-promotionRollNumber(b.st.roll);
 });
 const newRollMap=new Map(promotedStudents.map((x,i)=>[x.st.id,String(i+1)]));

 if(!confirm(`মোট ${decisions.length} জনের সিদ্ধান্ত সংরক্ষণ করবেন?\n\nউত্তীর্ণ: ${promoted} জন\nফেল/পুনরায়: ${repeat} জন\nশর্তসাপেক্ষ: ${conditional} জন\n\nনতুন রোল পরীক্ষার মোট নম্বরের মেধাক্রম অনুযায়ী হবে।`))return;

 const runId=`PROMO-${Date.now()}`;
 const recordedAt=new Date().toISOString();
 const history=[];
 let actualPromoted=0, actualRepeat=0, actualConditional=0, graduated=0;

 decisions.forEach(d=>{
  const st=db.students.find(s=>s.id===d.id);
  if(!st || !promotionStudentNeedsDecision(st,fromYear))return;
  const oldClass=String(st.class||"");
  const oldRoll=st.roll||"";
  const next=promotionNextClass(oldClass);
  const action=d.status;
  const newRoll=newRollMap.get(st.id)||"";
  const result=getPromotionResult(st,exam);

  if(!Array.isArray(st.academicHistory))st.academicHistory=[];
  st.academicHistory.push({academicYear:fromYear,class:oldClass,roll:oldRoll,action,promotionId:runId,recordedAt,resultExam:exam,resultTotal:result?result.total:null,resultPercentage:result?result.percentage:null,newRoll:newRoll||null});

  st.promotionYear=fromYear;
  st.promotionToYear=toYear;
  st.promotionDecision=action;
  st.promotionId=runId;
  st.promotionRecordedAt=recordedAt;

