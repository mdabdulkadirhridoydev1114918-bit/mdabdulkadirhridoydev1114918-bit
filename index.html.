function autoEnglishName(name){
 const map={
  "অ":"o","আ":"a","ই":"i","ঈ":"i","উ":"u","ঊ":"u","ঋ":"ri","এ":"e","ঐ":"oi","ও":"o","ঔ":"ou",
  "ক":"k","খ":"kh","গ":"g","ঘ":"gh","ঙ":"ng","চ":"ch","ছ":"chh","জ":"j","ঝ":"jh","ঞ":"n",
  "ট":"t","ঠ":"th","ড":"d","ঢ":"dh","ণ":"n","ত":"t","থ":"th","দ":"d","ধ":"dh","ন":"n",
  "প":"p","ফ":"f","ব":"b","ভ":"bh","ম":"m","য":"y","য়":"y","র":"r","ল":"l","শ":"sh","ষ":"sh","স":"s","হ":"h",
  "ড়":"r","ঢ়":"rh","ৎ":"t","ং":"ng","ঃ":"h","ঁ":"n","্":"","ড়":"r","ঢ়":"rh",
  "া":"a","ি":"i","ী":"i","ু":"u","ূ":"u","ৃ":"ri","ে":"e","ৈ":"oi","ো":"o","ৌ":"ou",
  "০":"0","১":"1","২":"2","৩":"3","৪":"4","৫":"5","৬":"6","৭":"7","৮":"8","৯":"9"
 };
 let out="";
 for(const ch of String(name||"")) out += (map[ch]!==undefined?map[ch]:ch);
 out=out.replace(/\s+/g," ").trim();
 return out.split(" ").map(w=>w?w.charAt(0).toUpperCase()+w.slice(1):w).join(" ");
}

