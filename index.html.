function routineClasses(){
 const base=classList();
 return base.length?base:["১ম","২য়","৩য়","৪র্থ","৫ম","৬ষ্ঠ","৭ম","৮ম","৯ম","১০ম"];
}

function dayBangla(dateStr){
 if(!dateStr) return "";
 const d=new Date(dateStr+"T00:00:00");
 if(isNaN(d.getTime())) return "";
 return ["রবিবার","সোমবার","মঙ্গলবার","বুধবার","বৃহস্পতিবার","শুক্রবার","শনিবার"][d.getDay()];
}

function routineSubjects(cls){
 const list=getSubjects(cls)||[];
 return list.map(x=>({
  name: typeof x === "string" ? x : (x.name ?? x[0] ?? ""),
  full: typeof x === "object" ? (x.full ?? x[1] ?? "") : ""
 })).filter(x=>x.name);
}

function renderRoutineClassSelect(){
 const sel=document.getElementById("routineClass");
 if(!sel)return;
 const classes=routineClasses();
 const old=sel.value;
 sel.innerHTML='<option value="">শ্রেণি নির্বাচন করুন</option>'+classes.map(c=>`<option value="${esc(c)}">${esc(c)} শ্রেণি</option>`).join("");
 if(old && classes.includes(old)) sel.value=old;
 else if(classes.length) sel.value=classes[0];
}

function toggleRoutineCustomExam(){
 const sel=document.getElementById('routineExam');
 const box=document.getElementById('routineExamCustom');
 if(box)box.style.display=sel?.value==='custom'?'block':'none';
}

function routineMetaStore(){
 db.settings.examRoutineMeta=db.settings.examRoutineMeta||{};
 return db.settings.examRoutineMeta;
}

function routineExamValue(){
 const sel=document.getElementById('routineExam');
 if(!sel)return '';
 return sel.value==='custom'?(document.getElementById('routineExamCustom')?.value.trim()||''):(sel.value||'');
}

function loadRoutineMeta(){
 const cls=document.getElementById('routineClass')?.value||routineClasses()[0];
 const m=routineMetaStore()[cls]||{};
 const year=document.getElementById('routineYear');
 const exam=document.getElementById('routineExam');
 const custom=document.getElementById('routineExamCustom');
 const shift=document.getElementById('routineShift');
 const venue=document.getElementById('routineVenue');
 const ins=document.getElementById('routineInstructions');
 if(year)year.value=m.year||db.settings.year||new Date().getFullYear();
 if(exam){const vals=[...exam.options].map(o=>o.value); if(m.exam && vals.includes(m.exam)){exam.value=m.exam; if(custom)custom.style.display='none';}else if(m.exam){exam.value='custom'; if(custom){custom.style.display='block';custom.value=m.exam;}}else exam.value='';}
 if(shift)shift.value=m.shift||'সকাল';
 if(venue)venue.value=m.venue||'';
 if(ins)ins.value=m.instructions||'';
}

function renderRoutineEditor(){
 const sel=document.getElementById('routineClass');
 const box=document.getElementById('routineEditor');
 if(!sel||!box)return;
 const cls=sel.value||routineClasses()[0];
 if(sel.value!==cls)sel.value=cls;
