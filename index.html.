  const role=document.getElementById("secNewRole")?.value||"teacher";
  buildSecurityPermissionEditor(defaultSecurityPermissions(role));
 }
 if(!currentUser || !isAdmin()){
   const n=document.getElementById("securityNotice");
   if(n)n.innerHTML="<b>🔒 এই অংশ শুধু Admin-এর জন্য।</b>";
 }
 const sel=document.getElementById("secAutoLock");
 if(sel) sel.value=String(db.security?.autoLockMinutes ?? 10);
 const box=document.getElementById("securityUsersTable");
 if(box){
   if(!isAdmin()){
     box.innerHTML='<div class="security-warn">Admin অনুমতি ছাড়া ব্যবহারকারী তালিকা পরিবর্তন করা যাবে না।</div>';
   }else{
     box.innerHTML=`<div class="table-wrap"><table>
       <thead><tr><th>Username</th><th>নাম</th><th>Role</th><th>Action</th></tr></thead>
       <tbody>${db.users.map(u=>`<tr>
        <td>${esc(u.username)}</td><td>${esc(u.name||"")}</td>
        <td>${esc(ROLE_LABELS[normalizeRole(u.role)]||u.role)}</td>
        <td>
         ${u.username==="admin"?
           '<span style="color:#198754">মূল Admin</span>':
           `<button onclick="resetSecurityUserPassword('${esc(u.username).replace(/'/g,"&#39;")}')">🔑 Reset Password</button>
            <button class="danger" onclick="deleteSecurityUser('${esc(u.username).replace(/'/g,"&#39;")}')">🗑️ Delete</button>`}
        </td>
       </tr>`).join("")}</tbody></table></div>`;
   }
 }
 renderSecurityBackupStatus();
}

function addSecurityUser(){
 if(!isAdmin()){alert("শুধু Admin নতুন ইউজার যোগ করতে পারবেন।");return;}
 const username=document.getElementById("secNewUsername").value.trim();
 const name=document.getElementById("secNewName").value.trim();
 const password=document.getElementById("secNewPassword").value;
 const role=normalizeRole(document.getElementById("secNewRole").value);
 if(!/^[A-Za-z0-9._-]{3,30}$/.test(username)){alert("ইউজারনেম ৩–৩০ অক্ষরের ইংরেজি অক্ষর/সংখ্যা/._- হতে হবে।");return;}
 if(password.length<6){alert("পাসওয়ার্ড কমপক্ষে ৬ অক্ষরের দিন।");return;}
 if(db.users.some(u=>String(u.username).toLowerCase()===username.toLowerCase())){alert("এই ইউজারনেম আগে থেকেই আছে।");return;}
 db.users.push({username,password,role,name:name||username,permissions:readSecurityPermissionEditor()});
 logAudit("নতুন ব্যবহারকারী",`${username} / ${ROLE_LABELS[role]}`);
 saveDB();
 ["secNewUsername","secNewName","secNewPassword"].forEach(id=>document.getElementById(id).value="");
 renderSecurityPage();
 alert("ব্যবহারকারী যোগ হয়েছে।");
}

function deleteSecurityUser(username){
 if(!isAdmin())return;
 if(username==="admin"){alert("মূল Admin অ্যাকাউন্ট মুছে ফেলা যাবে না।");return;}
 if(!confirm(`"${username}" ব্যবহারকারী মুছে ফেলবেন?`))return;
 db.users=db.users.filter(u=>u.username!==username);
 logAudit("ব্যবহারকারী মুছে ফেলা",username);
 saveDB();
 renderSecurityPage();
}

function resetSecurityUserPassword(username){
 if(!isAdmin())return;
 const u=db.users.find(x=>x.username===username);
 if(!u)return;
 const pass=prompt(`"${username}"-এর নতুন পাসওয়ার্ড দিন:`);
 if(pass===null)return;
 if(pass.length<6){alert("পাসওয়ার্ড কমপক্ষে ৬ অক্ষরের দিন।");return;}
 u.password=pass;
 logAudit("ব্যবহারকারীর পাসওয়ার্ড পরিবর্তন",username);
 saveDB();
 alert("পাসওয়ার্ড পরিবর্তন হয়েছে।");
}

function saveSecuritySettings(){
 if(!isAdmin()){alert("শুধু Admin এই সেটিংস পরিবর্তন করতে পারবেন।");return;}
 const minutes=Number(document.getElementById("secAutoLock").value||10);
 if(!db.security)db.security={};
 db.security.autoLockMinutes=minutes;
 logAudit("নিরাপত্তা সেটিংস",`Auto Lock: ${minutes?minutes+" মিনিট":"বন্ধ"}`);
 saveDB();
 startSecurityTimer();
 renderSecurityPage();
 alert("নিরাপত্তা সেটিংস সংরক্ষণ হয়েছে।");
}

function renderSecurityBackupStatus(){
 const status=document.getElementById("securityBackupStatus");
 const top=document.getElementById("securityLastBackup");
 let obj=null;
 try{obj=JSON.parse(localStorage.getItem(AUTO_BACKUP_KEY)||"null")}catch(e){}
 const txt=obj?.createdAt
   ?`সর্বশেষ Recovery Snapshot: ${new Date(obj.createdAt).toLocaleString("bn-BD")}`
   :"এখনও Recovery Snapshot তৈরি হয়নি।";
 if(status)status.innerHTML=`<div class="security-ok">✅ ${esc(txt)}</div>`;
 if(top)top.textContent=txt;
}

function createAutoRecoverySnapshot(force=false){
 const now=Date.now();
 if(!force && now-autoBackupLast<120000)return;
 try{
   const snapshot={backupVersion:"offline-school-recovery-v1",createdAt:new Date().toISOString(),data:db};
   localStorage.setItem(AUTO_BACKUP_KEY,JSON.stringify(snapshot));
   autoBackupLast=now;
 }catch(e){
   console.warn("Auto Recovery Snapshot রাখা যায়নি:",e);
 }
}

function downloadAutoBackup(){
 if(!isAdmin()){alert("শুধু Admin Recovery Snapshot ডাউনলোড করতে পারবেন।");return;}
 let obj=null;
 try{obj=JSON.parse(localStorage.getItem(AUTO_BACKUP_KEY)||"null")}catch(e){}
 if(!obj?.data){alert("Recovery Snapshot পাওয়া যায়নি। আগে একটি Backup নিন।");return;}
 const blob=new Blob([JSON.stringify(obj.data,null,2)],{type:"application/json"});
 const a=document.createElement("a");
 a.href=URL.createObjectURL(blob);
 a.download="school-recovery-"+new Date(obj.createdAt).toISOString().slice(0,10)+".json";
 a.click();
 setTimeout(()=>URL.revokeObjectURL(a.href),1000);
 logAudit("Recovery Snapshot ডাউনলোড","");
}

function clearAutoBackup(){
 if(!isAdmin()){alert("শুধু Admin এটি করতে পারবেন।");return;}
 if(!confirm("Recovery Snapshot মুছে ফেলবেন? মূল স্কুল ডাটা মুছবে না।"))return;
 localStorage.removeItem(AUTO_BACKUP_KEY);
 renderSecurityBackupStatus();
}

function resetSecurityTimer(){
 lastActivityAt=Date.now();
 if(securityTimer)return;
 startSecurityTimer();
}

function startSecurityTimer(){
 clearInterval(securityTimer);
 securityTimer=null;
 const mins=Number(db.security?.autoLockMinutes ?? 10);
 if(!currentUser || !mins)return;
 securityTimer=setInterval(()=>{
   if(!currentUser)return;
   if(Date.now()-lastActivityAt >= mins*60000) lockSchool();
 },15000);
}

function lockSchool(){
 if(!currentUser)return;
 logAudit("Auto Lock","নিষ্ক্রিয়তার কারণে সেশন লক হয়েছে");
 currentUser=null;
 localStorage.removeItem("schoolCurrentUser");
 clearInterval(securityTimer);
 securityTimer=null;
 const app=document.getElementById("app");
 const loginScreen=document.getElementById("loginScreen");
 if(app)app.style.display="none";
 if(loginScreen)loginScreen.style.display="flex";
 const err=document.getElementById("loginError");
 if(err)err.textContent="🔒 নিরাপত্তার জন্য সেশন লক হয়েছে। আবার Login করুন।";
}

function securityActivity(){
 if(currentUser)resetSecurityTimer();
}

["click","keydown","mousemove","touchstart"].forEach(evt=>{
 document.addEventListener(evt,securityActivity,{passive:true});
});

const _originalShowPage=showPage;
showPage=function(id){
 if(!canAccessPage(id)){
   alert("🔒 আপনার Access Level থেকে এই অংশে প্রবেশের অনুমতি নেই।");
   return;
 }
 _originalShowPage(id);
 if(id==="security")renderSecurityPage();
 securityActivity();
};

const _originalSaveDB=saveDB;
saveDB=function(){
 _originalSaveDB();
 createAutoRecoverySnapshot(false);
 if(currentUser && normalizeRole(currentUser.role)!=="student") syncSchoolDataToSupabase();
};

const _originalBackupData=backupData;
backupData=function(){
 if(!isAdmin()){alert("🔒 শুধু Admin পূর্ণ Backup নিতে পারবেন।");return;}
 _originalBackupData();
 logAudit("পূর্ণ JSON Backup নেওয়া","");
 createAutoRecoverySnapshot(true);
};

const _originalRestoreData=restoreData;
restoreData=function(input){
 if(!isAdmin()){alert("🔒 শুধু Admin Backup Restore করতে পারবেন।");input.value="";return;}
 const file=input.files?.[0];
 if(!file)return;
 if(!confirm("Restore করলে বর্তমান ডাটার জায়গায় Backup-এর ডাটা আসবে। আগে বর্তমান ডাটার একটি Backup নেওয়া হয়েছে তো?\\n\\nচালিয়ে যাবেন?")){
   input.value="";
   return;
 }
 _originalRestoreData(input);
};

const _originalLogin=login;
login=async function(){
 await _originalLogin();
 if(currentUser){
   applyAccessControl();
   resetSecurityTimer();
   logAudit("Login","সফল লগইন");
   if(normalizeRole(currentUser.role)!=="student") saveDB();
 }
};

const _originalLogout=logout;
logout=async function(){
 if(currentUser)logAudit("Logout","সফল Logout");
 clearInterval(securityTimer);
 securityTimer=null;
 await _originalLogout();
};

